# Supabase (required)
# Local: run `npx supabase start` and copy keys from `npx supabase status`
# Hosted: Project Settings → API
#
# Cloudflare Workers (critical):
# 1) Worker Variables (runtime) — use these non-NEXT_PUBLIC names so auth works
#    even when the build did not inline public vars:
#      SUPABASE_URL=https://<project-ref>.supabase.co
#      SUPABASE_ANON_KEY=<anon key>
#      SUPABASE_SERVICE_ROLE_KEY=<service_role key>
#      SITE_URL=https://billflow.yashpandit343.workers.dev
# 2) Build variables — also set NEXT_PUBLIC_* so the browser client works:
#      NEXT_PUBLIC_SUPABASE_URL=...
#      NEXT_PUBLIC_SUPABASE_ANON_KEY=...
#      NEXT_PUBLIC_SITE_URL=...
# Then redeploy.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — SERVER / SCRIPTS ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (auth redirects, password reset, Google OAuth return)
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: WhatsApp Cloud API webhook verify token (Meta dashboard)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional: document which email you promote to platform admin (see README SQL)
PLATFORM_ADMIN_EMAIL=owner@example.com
