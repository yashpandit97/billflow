# Supabase (required)
# Local: run `npx supabase start` and copy keys from `npx supabase status`
# Hosted: Project Settings → API
#
# Cloudflare Workers (critical):
# 1) Worker Variables (runtime) — use these non-NEXT_PUBLIC names so auth works
#    even when the build did not inline public vars:
#      SUPABASE_URL=https://<project-ref>.supabase.co
#      SUPABASE_ANON_KEY=<anon key>
#      SUPABASE_SERVICE_ROLE_KEY=<service_role key>
#      SITE_URL=https://billflow.yashpandit343.workers.dev
# 2) Build variables — also set NEXT_PUBLIC_* so the browser client works:
#      NEXT_PUBLIC_SUPABASE_URL=...
#      NEXT_PUBLIC_SUPABASE_ANON_KEY=...
#      NEXT_PUBLIC_SITE_URL=...
# Then redeploy.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — SERVER / SCRIPTS ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (auth redirects, password reset, Google OAuth return)
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API — platform sender (BillMoney's Meta number for all tenants)
# Callback URL: {SITE_URL}/api/whatsapp/webhook
# Verify token: paste the SAME value into Meta's "Verify token" field
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret from Meta App Dashboard → Settings → Basic (HMAC for POST payloads)
WHATSAPP_APP_SECRET=
# Optional: override DB platform_whatsapp_settings (recommended on Cloudflare)
# WHATSAPP_ENABLED=true
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_MESSAGE_TEMPLATE=invoice_delivery

# Optional: document which email you promote to platform admin (see README SQL)
PLATFORM_ADMIN_EMAIL=owner@example.com
