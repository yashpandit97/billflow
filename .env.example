# Supabase (required)
# Local: run `npx supabase start` and copy keys from `npx supabase status`
# Hosted: Project Settings → API
#
# Cloudflare Workers: set these as BOTH build env vars AND runtime Worker vars,
# then redeploy. NEXT_PUBLIC_* values are inlined into the client at build time.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — SERVER / SCRIPTS ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (auth redirects, password reset, Google OAuth return)
# Cloudflare: https://billflow.yashpandit343.workers.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: WhatsApp Cloud API webhook verify token (Meta dashboard)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional: document which email you promote to platform admin (see README SQL)
PLATFORM_ADMIN_EMAIL=owner@example.com
